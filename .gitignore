# Virtual Environment
.venv/
venv/
ENV/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local databases and generated outputs
*.db
*.sqlite3
data/outputs/*
!data/outputs/.gitkeep

# Synthetic data files (keep folder structure, ignore temporary heavy files if needed)
# Note: We will track small sample CSVs later, but ignore temporary Excel locks
~$*.xlsx

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log